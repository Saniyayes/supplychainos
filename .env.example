# SupplyChainOS Environment Variables
# Copy this to .env and fill in values.

# --- Groq LLM ---
LLM_ENABLED=true
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=qwen/qwen3.8-27b

# --- App Settings ---
APP_ENV=development
LOG_LEVEL=INFO
# Default SQLite:
DATABASE_URL=sqlite:///./supplychainos.db
# Or Docker PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplychainos
SECRET_KEY=change-me-in-production

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
